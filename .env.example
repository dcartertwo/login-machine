# Anthropic API key for AI analysis
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Browser Provider — choose "browserbase" (default) or "cloudflare"
# ---------------------------------------------------------------------------
BROWSER_PROVIDER=browserbase

# BrowserBase credentials (required when BROWSER_PROVIDER=browserbase)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Cloudflare Browser Rendering (required when BROWSER_PROVIDER=cloudflare)
# CF_BROWSER_WORKER_URL — URL of the deployed Worker (e.g. https://login-browser.your-subdomain.workers.dev)
# CF_BROWSER_API_KEY — shared secret matching AUTH_SECRET in the Worker's .dev.vars / secrets
CF_BROWSER_WORKER_URL=
CF_BROWSER_API_KEY=

# PostHog analytics (optional — leave blank to disable)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
